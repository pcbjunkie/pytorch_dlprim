+    static bool packed_byte_output(DataType dtype)
+    {
+        char const *flag=std::getenv("DLPRIM_PACKED_BYTE_OUTPUTS");
+        return flag && std::strcmp(flag,"1")==0 && (dtype==int8_data || dtype==uint8_data);
+    }
+
+    // Avoid r600 LLVM's broken global subword MSKOR writes. Math preserves its
+    // original scalar dtype, but stores into32-bit staging. Pack one owned word
+    // per work item and copy only the logical bytes with the OpenCL buffer API.
+    static void finish_packed_byte_output(Tensor &wide,Tensor &target,ExecutionContext const &e)
+    {
+        size_t count=target.shape().total_size();
+        if(count==0) return;
+        DLPRIM_CHECK(count<=std::numeric_limits<cl_uint>::max());
+        DLPRIM_CHECK(wide.device_offset()<=std::numeric_limits<cl_uint>::max());
+        Context ctx(e);
+        Tensor packed(ctx,Shape((count+3)/4),int32_data);
+        auto &program=gpu::Cache::instance().get_program(ctx,"pack_byte_output",
+                        "LITTLE_ENDIAN_BYTES",int(ctx.device().getInfo<CL_DEVICE_ENDIAN_LITTLE>()));
+        cl::Kernel kernel(program,"pack_byte_output");
+        kernel.setArg(0,wide.device_buffer());kernel.setArg(1,cl_uint(wide.device_offset()));
+        kernel.setArg(2,packed.device_buffer());kernel.setArg(3,cl_uint(packed.device_offset()));
+        kernel.setArg(4,cl_uint(count));
+        e.queue().enqueueNDRangeKernel(kernel,cl::NullRange,cl::NDRange((count+3)/4),cl::NullRange,
+                        e.events(),e.event("pack_byte_output"));
+        e.queue().enqueueCopyBuffer(packed.device_buffer(),target.device_buffer(),
+                        packed.device_offset()*sizeof(cl_uint),target.device_offset(),count,
+                        e.events(),e.event("copy_packed_byte_output"));
+        // The opt-in compatibility mode keeps both staging allocations alive
+        // until their last dependent command completes. No host value readback.
+        e.queue().finish();
+    }
