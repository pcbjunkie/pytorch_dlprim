+// for output windows containing that element; overlapping windows need no CAS.
+__kernel
+__attribute__((reqd_work_group_size(WG_SIZE,WG_SIZE,1)))
+void pooling_bw(int BC,int inp_H,int inp_W,int out_H,int out_W,
+               __global const dtype *src,ulong src_offset,
+               __global const dtype *tgt,ulong tgt_offset,
+               __global dtype *dx,ulong dx_offset)
+{
+    int r=get_global_id(0), c=get_global_id(1), bc=get_global_id(2);
+    if(bc>=BC || r>=inp_H || c>=inp_W) return;
+    src += src_offset + bc*inp_H*inp_W;
+    tgt += tgt_offset + bc*out_H*out_W;
+    dx += dx_offset + bc*inp_H*inp_W;
+    int pos=r*inp_W+c;
+    int rlo=(max(0,r+PAD_H-POOL_H+1)+STRIDE_H-1)/STRIDE_H;
+    int clo=(max(0,c+PAD_W-POOL_W+1)+STRIDE_W-1)/STRIDE_W;
+    int rhi=min(out_H-1,(r+PAD_H)/STRIDE_H);
+    int chi=min(out_W-1,(c+PAD_W)/STRIDE_W);
+    dtype sum=0;
+    for(int y=rlo;y<=rhi;++y) for(int x=clo;x<=chi;++x) {
+        int y0=max(0,y*STRIDE_H-PAD_H), x0=max(0,x*STRIDE_W-PAD_W);
+        int y1=min(inp_H,y*STRIDE_H-PAD_H+POOL_H);
+        int x1=min(inp_W,x*STRIDE_W-PAD_W+POOL_W);
+        dtype best=-INFINITY;
+        int winner=-1;
+        for(int iy=y0;iy<y1;++iy) for(int ix=x0;ix<x1;++ix) {
+            int index=iy*inp_W+ix;
+            dtype v=src[index];
+            if(winner<0 || v>best || isnan(v)) {best=v;winner=index;}
+        }
+        if(winner==pos) sum+=tgt[y*out_W+x];
+    }
+    dx[pos]+=sum;
+}
+#elif INDEX_MAX_SRC == 1
 __kernel
 __attribute__((reqd_work_group_size(WG_SIZE,WG_SIZE,1)))
 void pooling_bw(int BC,int inp_H,int inp_W,int out_H,int out_W,
