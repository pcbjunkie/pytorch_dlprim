diff --git a/src/kernels/conv_input_gather.cl b/src/kernels/conv_input_gather.cl
new file mode 100644
index 0000000..87e4501
--- /dev/null
+++ b/src/kernels/conv_input_gather.cl
@@ -0,0 +1,141 @@
+///////////////////////////////////////////////////////////////////////////////
+// Atomic-free input gradients: one pixel or a selected four-pixel group per item.
+// FP32 compatibility path; tensor addresses and work coordinates fit uint32.
+///////////////////////////////////////////////////////////////////////////////
+inline __attribute__((always_inline)) uint2 conv_divmod(uint n,uint d)
+{
+    // Compile-time convolution dimensions normally make this a constant branch.
+    if(d && (d & (d-1u))==0u) {
+        uint shift=0;
+        for(uint value=d;value>1u;value>>=1u)++shift;
+        return (uint2)(n>>shift,n&(d-1u));
+    }
+    uint q=0,r=0;
+    for(int b=31;b>=0;--b) {
+        uint carry=r>>31;
+        r=(r<<1)|((n>>b)&1u);
+        if(carry || r>=d) {r-=d;q|=1u<<b;}
+    }
+    return (uint2)(q,r);
+}
+__kernel void conv_input_gather(uint batch,uint ih,uint iw,uint oh,uint ow,
+                               __global float *dx,uint dxo,
+                               __global const float *w,uint wo,
+                               __global const float *dy,uint dyo,float factor)
+{
+#if GATHER_SPATIAL4
+    uint work_x=get_global_id(0),y=get_global_id(1),bc=get_global_id(2);
+#if SW == 2
+    // Four inputs of the same parity map to adjacent output-gradient pixels.
+    uint x=(work_x>>1)*8u+(work_x&1u);
+#else
+    uint x=work_x*4u;
+#endif
+    if(x>=iw || y>=ih || bc>=batch*CI)return;
+    uint2 channel=conv_divmod(bc,CI);
+    uint b=channel.x,ci=channel.y;
+    uint2 group=conv_divmod(ci,CI/GROUPS);
+    float4 sum=(float4)(0.0f);
+    for(int ky=0;ky<KH;++ky) {
+        int yr=(int)y+PH-ky*DH;
+        if(yr<0)continue;
+        uint2 row=conv_divmod((uint)yr,SH);
+        if(row.y || row.x>=oh)continue;
+        for(int kx=0;kx<KW;++kx) {
+            int xr=(int)x+PW-kx*DW;
+#if SW == 2
+            if(((uint)xr&1u)!=0u)continue;
+#endif
+            int col=xr<0 ? -1 : (int)conv_divmod((uint)xr,SW).x;
+            if(col<0) {
+                for(uint ocg=0;ocg<CO/GROUPS;++ocg) {
+                    uint oc=group.x*(CO/GROUPS)+ocg;
+                    uint wi=wo+((oc*(CI/GROUPS)+group.y)*KH+ky)*KW+kx;
+                    uint base=dyo+((b*CO+oc)*oh+row.x)*ow;
+                    float weight=w[wi];
+                    float4 values=vload4(0,dy+base);
+                    sum.s1+=weight*values.s0;
+                    sum.s2+=weight*values.s1;
+                    sum.s3+=weight*values.s2;
+                }
+            }
+            else if(col+3>=(int)ow) {
+                for(uint ocg=0;ocg<CO/GROUPS;++ocg) {
+                    uint oc=group.x*(CO/GROUPS)+ocg;
+                    uint wi=wo+((oc*(CI/GROUPS)+group.y)*KH+ky)*KW+kx;
+                    uint base=dyo+((b*CO+oc)*oh+row.x)*ow;
+                    float weight=w[wi];
+                    float4 values=vload4(0,dy+base+(uint)col-1u);
+                    sum.s0+=weight*values.s1;
+                    sum.s1+=weight*values.s2;
+                    sum.s2+=weight*values.s3;
+                }
+            }
+            else {
+                for(uint ocg=0;ocg<CO/GROUPS;++ocg) {
+                    uint oc=group.x*(CO/GROUPS)+ocg;
+                    uint wi=wo+((oc*(CI/GROUPS)+group.y)*KH+ky)*KW+kx;
+                    uint base=dyo+((b*CO+oc)*oh+row.x)*ow;
+                    float weight=w[wi];
+                    sum+=weight*vload4(0,dy+base+(uint)col);
+                }
+            }
+        }
+    }
+    uint pos=dxo+((b*CI+ci)*ih+y)*iw+x;
+#if SW == 2
+    if(factor!=0) {
+        sum.s0+=factor*dx[pos];sum.s1+=factor*dx[pos+2];
+        sum.s2+=factor*dx[pos+4];sum.s3+=factor*dx[pos+6];
+    }
+    dx[pos]=sum.s0;dx[pos+2]=sum.s1;dx[pos+4]=sum.s2;dx[pos+6]=sum.s3;
+#else
+    if(factor!=0)sum+=factor*vload4(0,dx+pos);
+    vstore4(sum,0,dx+pos);
+#endif
+#elif GATHER_VECTOR4
+    uint x=get_global_id(0)*4u,y=get_global_id(1),bc=get_global_id(2);
+    if(x>=iw || y>=ih || bc>=batch*CI)return;
+    uint2 channel=conv_divmod(bc,CI);
+    uint b=channel.x,ci=channel.y;
+    uint2 group=conv_divmod(ci,CI/GROUPS);
+    float4 sum=(float4)(0.0f);
+    for(uint ocg=0;ocg<CO/GROUPS;++ocg) {
+        uint oc=group.x*(CO/GROUPS)+ocg;
+        uint wi=wo+oc*(CI/GROUPS)+group.y;
+        uint di=dyo+((b*CO+oc)*oh+y)*ow+x;
+        sum+=w[wi]*vload4(0,dy+di);
+    }
+    uint pos=dxo+((b*CI+ci)*ih+y)*iw+x;
+    if(factor!=0)sum+=factor*vload4(0,dx+pos);
+    vstore4(sum,0,dx+pos);
+#else
+    uint x=get_global_id(0),y=get_global_id(1),bc=get_global_id(2);
+    if(x>=iw || y>=ih || bc>=batch*CI)return;
+    uint2 channel=conv_divmod(bc,CI);
+    uint b=channel.x,ci=channel.y;
+    uint2 group=conv_divmod(ci,CI/GROUPS);
+    float sum=0;
+    for(int ky=0;ky<KH;++ky) {
+        int yr=(int)y+PH-ky*DH;
+        if(yr<0)continue;
+        uint2 row=conv_divmod((uint)yr,SH);
+        if(row.y || row.x>=oh)continue;
+        for(int kx=0;kx<KW;++kx) {
+            int xr=(int)x+PW-kx*DW;
+            if(xr<0)continue;
+            uint2 col=conv_divmod((uint)xr,SW);
+            if(col.y || col.x>=ow)continue;
+            for(uint ocg=0;ocg<CO/GROUPS;++ocg) {
+                uint oc=group.x*(CO/GROUPS)+ocg;
+                uint wi=((oc*(CI/GROUPS)+group.y)*KH+ky)*KW+kx;
+                uint di=((b*CO+oc)*oh+row.x)*ow+col.x;
+                sum+=w[wo+wi]*dy[dyo+di];
+            }
+        }
+    }
+    uint pos=dxo+((b*CI+ci)*ih+y)*iw+x;
+    if(factor==0)dx[pos]=sum;
+    else dx[pos]=factor*dx[pos]+sum;
+#endif
+}
diff --git a/src/kernels/filter_split_reduce.cl b/src/kernels/filter_split_reduce.cl
new file mode 100644
index 0000000..1cb529c
--- /dev/null
+++ b/src/kernels/filter_split_reduce.cl
@@ -0,0 +1,13 @@
+// Fixed-order, destination-owned reduction of disjoint filter partials.
+__kernel void filter_split_reduce(uint count,
+                                 __global const float *partial,uint po,
+                                 __global float *dw,uint wo,float factor)
+{
+    uint i=get_global_id(0);
+    if(i>=count)return;
+    float sum=0;
+    for(uint part=0;part<FILTER_PARTITIONS;++part)
+        sum+=partial[po+part*count+i];
+    if(factor==0)dw[wo+i]=sum;
+    else dw[wo+i]=factor*dw[wo+i]+sum;
+}
diff --git a/src/kernels/pack_byte_output.cl b/src/kernels/pack_byte_output.cl
new file mode 100644
index 0000000..e1431be
--- /dev/null
+++ b/src/kernels/pack_byte_output.cl
@@ -0,0 +1,19 @@
+// One work item owns one complete32-bit destination word; no subword stores.
+__kernel void pack_byte_output(__global const int *src,uint src_offset,
+                               __global uint *dst,uint dst_offset,uint count)
+{
+    uint word=get_global_id(0);
+    uint words=(count>>2)+((count&3u)!=0u);
+    if(word>=words)return;
+    uint packed=0;
+    for(uint lane=0;lane<4;lane++) {
+        uint i=word*4+lane;
+        uint value=i<count?((uint)src[src_offset+i]&255u):0u;
+#if LITTLE_ENDIAN_BYTES
+        packed|=value<<(lane*8);
+#else
+        packed|=value<<((3-lane)*8);
+#endif
+    }
+    dst[dst_offset+word]=packed;
+}
