diff --git a/src/kernels/depthwise_stride2.cl b/src/kernels/depthwise_stride2.cl
new file mode 100644
index 0000000..9d177be
--- /dev/null
+++ b/src/kernels/depthwise_stride2.cl
@@ -0,0 +1,54 @@
+#include "defs.h"
+// One output per lane: nine taps, no padded GEMM channel dimension.
+__kernel void depthwise_stride2(
+    __global const float *x,ulong xo,__global const float *w,ulong wo,
+#if BIAS
+    __global const float *bias,ulong bo,
+#endif
+    __global float *out,ulong oo,float factor)
+{
+    uint p=get_global_id(0)*PIXELS,bc=get_global_id(1);
+    if(p>=DST_H*DST_W)return;
+    uint c=bc%CHANNELS;int y=(int)(p/DST_W)*2-1,x0=(int)(p%DST_W)*2-1;
+    ulong src=xo+(ulong)bc*SRC_H*SRC_W;
+#if PIXELS == 4
+    float4 sum=(float4)(0.0f);
+    #pragma unroll
+    for(int ky=0;ky<3;++ky) {
+        int iy=y+ky;float values[9];
+        #pragma unroll
+        for(int j=0;j<9;++j){int ix=x0+j;values[j]=0.0f;
+            if((uint)iy<SRC_H && (uint)ix<SRC_W)values[j]=x[src+(ulong)iy*SRC_W+ix];}
+        #pragma unroll
+        for(int kx=0;kx<3;++kx){
+            float4 v=(float4)(values[kx],values[kx+2],values[kx+4],values[kx+6]);
+            sum=mad(v,(float4)(w[wo+(ulong)c*9+ky*3+kx]),sum);
+        }
+    }
+#else
+    float sum=0.0f;
+    #pragma unroll
+    for(int ky=0;ky<3;++ky) {
+        int iy=y+ky;
+        #pragma unroll
+        for(int kx=0;kx<3;++kx) {
+            int ix=x0+kx;float value=0.0f;
+            if((uint)iy<SRC_H && (uint)ix<SRC_W)value=x[src+(ulong)iy*SRC_W+ix];
+            sum=mad(value,w[wo+(ulong)c*9+ky*3+kx],sum);
+        }
+    }
+#endif
+#if BIAS
+    sum+=bias[bo+c];
+#endif
+    ulong dst=oo+(ulong)bc*DST_H*DST_W+p;
+#if PIXELS == 4
+    float4 value=ACTIVATION_F(sum);
+    if(factor!=0.0f)value+=factor*vload4(0,out+dst);
+    vstore4(value,0,out+dst);
+#else
+    float value=ACTIVATION_F(sum);
+    if(factor!=0.0f)value+=factor*out[dst];
+    out[dst]=value;
+#endif
+}
diff --git a/src/kernels/filter_split_reduce.cl b/src/kernels/filter_split_reduce.cl
new file mode 100644
index 0000000..1cb529c
--- /dev/null
+++ b/src/kernels/filter_split_reduce.cl
@@ -0,0 +1,13 @@
+// Fixed-order, destination-owned reduction of disjoint filter partials.
+__kernel void filter_split_reduce(uint count,
+                                 __global const float *partial,uint po,
+                                 __global float *dw,uint wo,float factor)
+{
+    uint i=get_global_id(0);
+    if(i>=count)return;
+    float sum=0;
+    for(uint part=0;part<FILTER_PARTITIONS;++part)
+        sum+=partial[po+part*count+i];
+    if(factor==0)dw[wo+i]=sum;
+    else dw[wo+i]=factor*dw[wo+i]+sum;
+}
