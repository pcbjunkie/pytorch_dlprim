+__kernel void input_grad_transpose(__global const float *w,ulong wo,
+                                   __global float *t,ulong to)
+{
+    uint j=get_global_id(0),oc=get_global_id(1);
+    if(j>=CI*KH*KW || oc>=CO)return;
+    t[to+(ulong)j*CO+oc]=w[wo+(ulong)oc*CI*KH*KW+j];
+}
+
+// For stride1/pad1 3x3, dx is forward convolution of dy with channel-
+// transposed weights rotated by180degrees. No activation or bias is applied.
+__kernel void input_grad_winograd_weights(__global const float *w,ulong wo,
+                                         __global float *t,ulong to)
+{
+    uint j=get_global_id(0),oc=get_global_id(1);
+    if(j>=CI*9 || oc>=CO)return;
+    uint ci=j/9,k=j%9;
+    t[to+((ulong)ci*CO+oc)*9+k]=w[wo+((ulong)oc*CI+ci)*9+8-k];
+}
+
+// Gather the already channel-reduced patch gradients. Each lane owns one
+// input pixel, so overlapping spatial contributions need no atomics.
+__kernel void input_grad_col2im(__global const float *col,ulong offset,
+                               __global float *dx,ulong dxo,float factor)
+{
+    uint p=get_global_id(0),bc=get_global_id(1);
+    if(p>=IH*IW)return;
+    uint ci=bc%CI,b=bc/CI;
+    int iy=p/IW,ix=p%IW;
+    float sum=0.0f;
+    #pragma unroll
+    for(int ky=0;ky<KH;ky++) {
+        int y=iy+PH-ky;
+        if(y<0 || y%SH || y/SH>=OH)continue;
+        #pragma unroll
+        for(int kx=0;kx<KW;kx++) {
+            int x=ix+PW-kx;
+            if(x<0 || x%SW || x/SW>=OW)continue;
+            ulong pos=offset+(((ulong)b*CI+ci)*KH*KW+ky*KW+kx)*OH*OW+(y/SH)*OW+x/SW;
+            sum+=col[pos];
+        }
+    }
+    ulong pos=dxo+(ulong)bc*IH*IW+p;
+    if(factor!=0.0f)sum+=factor*dx[pos];
+    dx[pos]=sum;
+}
+
+#if KH == 3 && KW == 3 && SH == 2 && SW == 2 && PH == 1 && PW == 1 && IH == 2*OH && IW == 2*OW
+// An output owner writes both input parities for one strided lattice cell.
+__kernel void input_grad_col2im_tile2(__global const float *col,ulong offset,
+                                     __global float *dx,ulong dxo,float factor)
+{
+    uint p=get_global_id(0),bc=get_global_id(1);
+    if(p>=OH*OW)return;
+
+    uint y=p/OW,x=p%OW;
+    const uint plane=OH*OW;
+    col+=offset+(ulong)bc*9*plane+p;
+    const bool right=x+1<OW;
+    const bool bottom=y+1<OH;
+
+    float even_even=col[4*plane];
+    float even_odd=(right ? col[3*plane+1] : 0.0f)+col[5*plane];
+    float odd_even=(bottom ? col[plane+OW] : 0.0f)+col[7*plane];
+    float odd_odd=(right && bottom ? col[OW+1] : 0.0f);
+    odd_odd+=bottom ? col[2*plane+OW] : 0.0f;
+    odd_odd+=right ? col[6*plane+1] : 0.0f;
+    odd_odd+=col[8*plane];
+
+    float2 upper=(float2)(even_even,even_odd);
+    float2 lower=(float2)(odd_even,odd_odd);
+    dx+=dxo+(ulong)bc*IH*IW+2*y*IW+2*x;
+    if(factor!=0.0f) {
+        upper+=factor*vload2(0,dx);
+        lower+=factor*vload2(0,dx+IW);
+    }
+    vstore2(upper,0,dx);
+    vstore2(lower,0,dx+IW);
+}
+#endif
diff --git a/src/kernels/conv_input_gather.cl b/src/kernels/conv_input_gather.cl
new file mode 100644
index 0000000..87e4501
--- /dev/null
+++ b/src/kernels/conv_input_gather.cl
@@ -0,0 +1,141 @@
+///////////////////////////////////////////////////////////////////////////////
+// Atomic-free input gradients: one pixel or a selected four-pixel group per item.
+// FP32 compatibility path; tensor addresses and work coordinates fit uint32.
+///////////////////////////////////////////////////////////////////////////////
+inline __attribute__((always_inline)) uint2 conv_divmod(uint n,uint d)
+{
+    // Compile-time convolution dimensions normally make this a constant branch.
+    if(d && (d & (d-1u))==0u) {
+        uint shift=0;
+        for(uint value=d;value>1u;value>>=1u)++shift;
+        return (uint2)(n>>shift,n&(d-1u));
+    }
+    uint q=0,r=0;
+    for(int b=31;b>=0;--b) {
+        uint carry=r>>31;
+        r=(r<<1)|((n>>b)&1u);
+        if(carry || r>=d) {r-=d;q|=1u<<b;}
+    }
+    return (uint2)(q,r);
+}
+__kernel void conv_input_gather(uint batch,uint ih,uint iw,uint oh,uint ow,
+                               __global float *dx,uint dxo,
+                               __global const float *w,uint wo,
+                               __global const float *dy,uint dyo,float factor)
+{
+#if GATHER_SPATIAL4
+    uint work_x=get_global_id(0),y=get_global_id(1),bc=get_global_id(2);
+#if SW == 2
+    // Four inputs of the same parity map to adjacent output-gradient pixels.
+    uint x=(work_x>>1)*8u+(work_x&1u);
+#else
+    uint x=work_x*4u;
+#endif
+    if(x>=iw || y>=ih || bc>=batch*CI)return;
+    uint2 channel=conv_divmod(bc,CI);
+    uint b=channel.x,ci=channel.y;
+    uint2 group=conv_divmod(ci,CI/GROUPS);
+    float4 sum=(float4)(0.0f);
+    for(int ky=0;ky<KH;++ky) {
+        int yr=(int)y+PH-ky*DH;
+        if(yr<0)continue;
+        uint2 row=conv_divmod((uint)yr,SH);
+        if(row.y || row.x>=oh)continue;
+        for(int kx=0;kx<KW;++kx) {
+            int xr=(int)x+PW-kx*DW;
+#if SW == 2
+            if(((uint)xr&1u)!=0u)continue;
+#endif
+            int col=xr<0 ? -1 : (int)conv_divmod((uint)xr,SW).x;
+            if(col<0) {
+                for(uint ocg=0;ocg<CO/GROUPS;++ocg) {
+                    uint oc=group.x*(CO/GROUPS)+ocg;
+                    uint wi=wo+((oc*(CI/GROUPS)+group.y)*KH+ky)*KW+kx;
+                    uint base=dyo+((b*CO+oc)*oh+row.x)*ow;
+                    float weight=w[wi];
+                    float4 values=vload4(0,dy+base);
+                    sum.s1+=weight*values.s0;
+                    sum.s2+=weight*values.s1;
+                    sum.s3+=weight*values.s2;
+                }
+            }
+            else if(col+3>=(int)ow) {
+                for(uint ocg=0;ocg<CO/GROUPS;++ocg) {
+                    uint oc=group.x*(CO/GROUPS)+ocg;
+                    uint wi=wo+((oc*(CI/GROUPS)+group.y)*KH+ky)*KW+kx;
+                    uint base=dyo+((b*CO+oc)*oh+row.x)*ow;
+                    float weight=w[wi];
+                    float4 values=vload4(0,dy+base+(uint)col-1u);
+                    sum.s0+=weight*values.s1;
+                    sum.s1+=weight*values.s2;
+                    sum.s2+=weight*values.s3;
+                }
+            }
+            else {
+                for(uint ocg=0;ocg<CO/GROUPS;++ocg) {
+                    uint oc=group.x*(CO/GROUPS)+ocg;
+                    uint wi=wo+((oc*(CI/GROUPS)+group.y)*KH+ky)*KW+kx;
+                    uint base=dyo+((b*CO+oc)*oh+row.x)*ow;
+                    float weight=w[wi];
+                    sum+=weight*vload4(0,dy+base+(uint)col);
+                }
+            }
+        }
+    }
+    uint pos=dxo+((b*CI+ci)*ih+y)*iw+x;
+#if SW == 2
+    if(factor!=0) {
+        sum.s0+=factor*dx[pos];sum.s1+=factor*dx[pos+2];
+        sum.s2+=factor*dx[pos+4];sum.s3+=factor*dx[pos+6];
+    }
+    dx[pos]=sum.s0;dx[pos+2]=sum.s1;dx[pos+4]=sum.s2;dx[pos+6]=sum.s3;
+#else
+    if(factor!=0)sum+=factor*vload4(0,dx+pos);
+    vstore4(sum,0,dx+pos);
+#endif
+#elif GATHER_VECTOR4
+    uint x=get_global_id(0)*4u,y=get_global_id(1),bc=get_global_id(2);
+    if(x>=iw || y>=ih || bc>=batch*CI)return;
+    uint2 channel=conv_divmod(bc,CI);
+    uint b=channel.x,ci=channel.y;
+    uint2 group=conv_divmod(ci,CI/GROUPS);
+    float4 sum=(float4)(0.0f);
+    for(uint ocg=0;ocg<CO/GROUPS;++ocg) {
+        uint oc=group.x*(CO/GROUPS)+ocg;
+        uint wi=wo+oc*(CI/GROUPS)+group.y;
+        uint di=dyo+((b*CO+oc)*oh+y)*ow+x;
+        sum+=w[wi]*vload4(0,dy+di);
+    }
+    uint pos=dxo+((b*CI+ci)*ih+y)*iw+x;
+    if(factor!=0)sum+=factor*vload4(0,dx+pos);
+    vstore4(sum,0,dx+pos);
+#else
+    uint x=get_global_id(0),y=get_global_id(1),bc=get_global_id(2);
+    if(x>=iw || y>=ih || bc>=batch*CI)return;
+    uint2 channel=conv_divmod(bc,CI);
+    uint b=channel.x,ci=channel.y;
+    uint2 group=conv_divmod(ci,CI/GROUPS);
+    float sum=0;
+    for(int ky=0;ky<KH;++ky) {
+        int yr=(int)y+PH-ky*DH;
+        if(yr<0)continue;
+        uint2 row=conv_divmod((uint)yr,SH);
+        if(row.y || row.x>=oh)continue;
+        for(int kx=0;kx<KW;++kx) {
+            int xr=(int)x+PW-kx*DW;
+            if(xr<0)continue;
+            uint2 col=conv_divmod((uint)xr,SW);
+            if(col.y || col.x>=ow)continue;
+            for(uint ocg=0;ocg<CO/GROUPS;++ocg) {
+                uint oc=group.x*(CO/GROUPS)+ocg;
+                uint wi=((oc*(CI/GROUPS)+group.y)*KH+ky)*KW+kx;
+                uint di=((b*CO+oc)*oh+row.x)*ow+col.x;
+                sum+=w[wo+wi]*dy[dyo+di];
+            }
+        }
+    }
+    uint pos=dxo+((b*CI+ci)*ih+y)*iw+x;
+    if(factor==0)dx[pos]=sum;
+    else dx[pos]=factor*dx[pos]+sum;
+#endif
+}
diff --git a/src/kernels/conv_pointwise_reduce.cl b/src/kernels/conv_pointwise_reduce.cl
new file mode 100644
index 0000000..f3f086e
--- /dev/null
+++ b/src/kernels/conv_pointwise_reduce.cl
@@ -0,0 +1,26 @@
+// Few output channels: spatial lanes read contiguous data, with no padded M tile.
+__kernel void pointwise_reduce(uint plane,
+    __global const float *input, ulong input_offset,
+    __global const float *weights, ulong weight_offset,
+#if BIAS
+    __global const float *bias, ulong bias_offset,
+#endif
+    __global float *output, ulong output_offset, float scale)
+{
+    uint i=get_global_id(0);
+    uint bc=get_global_id(1);
+    uint b=bc/OUTPUT_CHANNELS,oc=bc%OUTPUT_CHANNELS;
+    if(i>=plane)return;
+    ulong base=input_offset+(ulong)b*CHANNELS*plane+i;
+    ulong row=weight_offset+(ulong)oc*CHANNELS;
+    float sum=0.0f;
+    #pragma unroll
+    for(uint c=0;c<CHANNELS;++c)
+        sum=mad(input[base+(ulong)c*plane],weights[row+c],sum);
+#if BIAS
+    sum+=bias[bias_offset+oc];
+#endif
+    ulong pos=output_offset+(ulong)bc*plane+i;
+    if(scale!=0.0f)sum+=scale*output[pos];
+    output[pos]=sum;
+}
