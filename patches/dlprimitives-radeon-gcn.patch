--- a/src/kernels/softmax.cl
+++ b/src/kernels/softmax.cl
@@ -204,3 +204,74 @@ void softmax_backward(int batch,int channels,int extra_batch,
     }
 }
 
+
+#if defined(SOFTMAX_2040)
+__kernel
+__attribute__((reqd_work_group_size(1,WG_SIZE,1)))
+void softmax_2040(__global const float *input, ulong input_offset,
+                  __global float *output, ulong output_offset)
+{
+    const ulong row = get_global_id(0) * (ulong)2040;
+    const int lane = get_local_id(1);
+    const int vectors = 2040 / 4;
+    input += input_offset + row;
+    output += output_offset + row;
+    float4 values[(2040 / 4 + WG_SIZE - 1) / WG_SIZE];
+    float peak = -DTYPE_MAX;
+    int item = 0;
+    for(int column = lane; column < vectors; column += WG_SIZE, ++item) {
+        float4 value = vload4(column, input);
+        values[item] = value;
+        peak = max(peak, max(max(value.x, value.y), max(value.z, value.w)));
+    }
+    REDUCE_PREPARE(WG_SIZE,float);
+    my_work_group_reduce_max(peak);
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+    float total = 0.0f;
+    item = 0;
+    for(int column = lane; column < vectors; column += WG_SIZE, ++item) {
+        float4 value = exp(values[item] - peak);
+        values[item] = value;
+        total += (value.x + value.y) + (value.z + value.w);
+    }
+    my_work_group_reduce_add(total);
+
+    float scale = 1.0f / total;
+    item = 0;
+    for(int column = lane; column < vectors; column += WG_SIZE, ++item)
+        vstore4(values[item] * scale, column, output);
+}
+
+__kernel
+__attribute__((reqd_work_group_size(1,WG_SIZE,1)))
+void softmax_backward_2040(__global float *dx, ulong dx_offset,
+                           __global const float *y, ulong y_offset,
+                           __global const float *dy, ulong dy_offset)
+{
+    const ulong row = get_global_id(0) * (ulong)2040;
+    const int lane = get_local_id(1);
+    const int vectors = 2040 / 4;
+    dx += dx_offset + row;
+    y += y_offset + row;
+    dy += dy_offset + row;
+
+    float4 probabilities[(2040 / 4 + WG_SIZE - 1) / WG_SIZE];
+    float4 upstream[(2040 / 4 + WG_SIZE - 1) / WG_SIZE];
+    float sum = 0.0f;
+    int item = 0;
+    for(int col = lane; col < vectors; col += WG_SIZE, ++item) {
+        float4 p = vload4(col,y);
+        float4 g = vload4(col,dy);
+        probabilities[item] = p;
+        upstream[item] = g;
+        sum += dot(p,g);
+    }
+    REDUCE_PREPARE(WG_SIZE,float);
+    my_work_group_reduce_add(sum);
+
+    item = 0;
+    for(int col = lane; col < vectors; col += WG_SIZE, ++item)
+        vstore4(probabilities[item] * (upstream[item] - sum),col,dx);
+}
+#endif
